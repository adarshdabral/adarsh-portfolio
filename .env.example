# --- Professional / GitHub.live -------------------------------------------
# GitHub username to show stats for.
GITHUB_USERNAME=your-github-username

# Optional but recommended: a GitHub personal access token with NO scopes
# (public read access only). Without it, GitHub.live falls back to public
# REST endpoints only, which means no pinned repos and no contribution graph
# (GitHub's GraphQL API, which is required for those, always requires auth).
# Never expose this to the client — it is only read inside the
# app/api/github route handler.
GITHUB_TOKEN=

# --- Professional / LeetCode.live -------------------------------------------
# LeetCode username to show stats for.
LEETCODE_USERNAME=your-leetcode-username

# --- Contact -----------------------------------------------------------------
# Optional: a Resend API key to actually send emails from the Contact app's
# form. Without it, the /api/contact route logs submissions server-side and
# still returns success, so the UI never breaks — wire this up when ready.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com

# --- Admin CMS (the lock icon in the dock) -----------------------------------
# Signs into a small content editor for Experience/Education/Skills/Social
# links. It writes straight to the content/*.json files on disk, so it's
# built for local authoring (npm run dev, edit, commit, deploy) — on Vercel
# the filesystem is read-only at runtime, so edits made against a live
# deployment won't persist there.
#
# Change these from the defaults before deploying anywhere reachable by
# others. A short numeric password is fine for poking around locally, but
# weak against anyone who finds the login form.
CMS_USERNAME=your-username
CMS_PASSWORD=change-me

# Random secret used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
